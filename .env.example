# PaleonIA — copie este arquivo para .env e ajuste o que precisar.
# Variáveis já definidas no sistema prevalecem sobre o .env.

APP_NAME=PaleonIA
APP_VERSION=1.0.0

# Login. Com DATABASE_URL, o usuário fica na tabela users.
# Se a tabela estiver vazia, AUTH_USERNAME e AUTH_PASSWORD criam o primeiro.
# Sem DATABASE_URL, AUTH_PASSWORD liga o login local. Vazio deixa a mesa aberta.
AUTH_USERNAME=paleonia
AUTH_PASSWORD=
AUTH_SECRET=

# Servidor local
PALEONIA_HOST=127.0.0.1
PALEONIA_PORT=8878
PALEONIA_WORK_DIR=output/desk
PALEONIA_OPEN_BROWSER=true

# Leitura. ollama usa o modelo local. openai e openrouter usam uma API
# compatível com o formato da OpenAI (OpenRouter, vLLM, etc.).
LLM_PROVIDER=ollama
# LLM_PROVIDER=openrouter
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_API_KEY=
# LLM_MODEL=qwen/qwen3-vl-8b-instruct
LLM_JSON_MODE=true

# Ollama. OLLAMA_HOST é a URL do serviço.
# OLLAMA_MODEL só vale quando LLM_PROVIDER=ollama e LLM_MODEL está vazio.
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3-vl:8b-instruct
OLLAMA_TIMEOUT=900
OLLAMA_TEMPERATURE=0.1
OLLAMA_TOP_P=0.85
OLLAMA_NUM_CTX=4096
OLLAMA_NUM_PREDICT=1600
OLLAMA_IMAGE_LONG_SIDE=1600
OLLAMA_ATTEMPTS=2

# Kraken (localização das linhas). KRAKEN_PYTHON é o python.exe, se o Kraken
# estiver noutro ambiente.
KRAKEN_DEVICE=auto
KRAKEN_PYTHON=
KRAKEN_TIMEOUT=600

# Imagem e leitura
JPEG_QUALITY=93
DEFAULT_SENSITIVITY=0.55
MAX_IMAGE_SIDE=12000
MAX_TEXT_CHARS=20000
READ_GROUP_MAX_HEIGHT=520
READ_GROUP_MAX_COUNT=8

# Busca vetorial. Sem DATABASE_URL a mesa funciona e a busca fica desligada.
# Suba o Postgres com: docker compose up -d
# A migration 002 grava vector(768). EMBED_DIMENSIONS precisa ser 768.
# DATABASE_URL=postgresql://paleonia:paleonia@127.0.0.1:5432/paleonia
# EMBED_PROVIDER=ollama
# EMBED_MODEL=nomic-embed-text
# EMBED_DIMENSIONS=768
# EMBED_BASE_URL=
# EMBED_API_KEY=
# EMBED_TIMEOUT=60
